{
  "name": "beyondthevale",
  "private": true,
  "version": "2.0.0",
  "description": "beyondthevale.net — Cody Peterson's consulting site. Plain HTML/CSS/JS served by GitHub Pages; pages are stamped from src/ by scripts/build.mjs and the output is committed.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "serve": "http-server -p 8080 -c-1 .",
    "pretest": "npm run build:check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"*.html\" \"services/*.html\" \"projects/**/*.html\"",
    "notify:indexnow": "node scripts/indexnow.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "html-validate": "^9.5.0",
    "http-server": "^14.1.1"
  }
}
